<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Situational while bond is active (+2/+2 default via Thought_ApprenticeBonded). -->
  <ThoughtDef>
    <defName>AB_Bonded</defName>
    <workerClass>ApprenticeBond.ThoughtWorker_ApprenticeBonded</workerClass>
    <thoughtClass>ApprenticeBond.Thought_ApprenticeBonded</thoughtClass>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>apprentice bond ({0})</label>
        <description>I'm bound by an apprentice contract. Teaching and learning keep us sharp.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Short celebrate on forming. -->
  <ThoughtDef>
    <defName>AB_BondFormed</defName>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>new apprentice bond</label>
        <description>We sealed a mentor–apprentice bond. Feels purposeful.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Temporary −3 on break (settings). -->
  <ThoughtDef>
    <defName>AB_BondBroken</defName>
    <thoughtClass>ApprenticeBond.Thought_BondBroken</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>bond broken</label>
        <description>Our apprentice bond was dissolved. The path feels cut short.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Mentor death trauma for apprentice (−8～−12, default −10). -->
  <ThoughtDef>
    <defName>AB_MentorDied</defName>
    <thoughtClass>ApprenticeBond.Thought_MentorDied</thoughtClass>
    <durationDays>12</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>mentor died</label>
        <description>My mentor is gone. The lessons stop cold — and so does something in me.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AB_GraduatedMentor</defName>
    <thoughtClass>ApprenticeBond.Thought_Graduated</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>2</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>apprentice graduated</label>
        <description>My apprentice finished the bond. Proud of the work we put in.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AB_GraduatedApprentice</defName>
    <thoughtClass>ApprenticeBond.Thought_Graduated</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>2</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>graduated</label>
        <description>I completed my apprenticeship. Ready to stand on my own skill.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>

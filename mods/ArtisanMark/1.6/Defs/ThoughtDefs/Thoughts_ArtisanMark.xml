<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Wearing apparel you crafted yourself. Mood from settings (default +2). -->
  <ThoughtDef>
    <defName>AM_SelfMadeGear</defName>
    <workerClass>ArtisanMark.ThoughtWorker_ArtisanSelfMade</workerClass>
    <thoughtClass>ArtisanMark.Thought_ArtisanSelfMade</thoughtClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>my own craft</label>
        <description>I'm wearing something I made with my own hands. It fits the way I intended.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Wearing gear from a dead friend/lover/bonded. One stack. Mood from settings (default +4). -->
  <ThoughtDef>
    <defName>AM_LegacyGear</defName>
    <workerClass>ArtisanMark.ThoughtWorker_ArtisanLegacy</workerClass>
    <thoughtClass>ArtisanMark.Thought_ArtisanLegacy</thoughtClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>heirloom from {0}</label>
        <description>This was made by {0}. They're gone, but their work still keeps me warm.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>

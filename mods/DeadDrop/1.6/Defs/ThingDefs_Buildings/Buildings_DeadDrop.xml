<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DD_DeadDropCairn</defName>
    <label>dead-drop cairn</label>
    <description>A deliberately ordinary stone pile at the map edge. Contacts leave coded parcels here; colonists service the drop by hand. Quiet when idle. One live grey-market order per map maximum — this is not a free silver tap.</description>
    <thingClass>DeadDrop.Building_DeadDrop</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/DeadDropCairn</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15, 1.15)</drawSize>
      <damageData>
        <rect>(0.15,0.2,0.7,0.65)</rect>
      </damageData>
      <shadowData>
        <volume>(0.7, 0.2, 0.55)</volume>
        <offset>(0, 0, -0.05)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>UI/Designators/DeadDrop</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.20</fillPercent>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
      <Mass>40</Mass>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <WoodLog>15</WoodLog>
    </costList>
    <building>
      <isEdifice>true</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Stone_Small</destroySound>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <size>(1,1)</size>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2510</uiOrder>
    <researchPrerequisites>
      <li>DD_GreyChannels</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <placeWorkers>
      <li>DeadDrop.PlaceWorker_DeadDropEdge</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <tickerType>Never</tickerType>
    <drawerType>MapMeshOnly</drawerType>
  </ThingDef>

</Defs>

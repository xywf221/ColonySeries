<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>Plant_FC_GreenManure</defName>
    <label>green manure clover</label>
    <description>A fast nitrogen-fixing clover mix grown to be plowed back into the soil. Harvesting as seed gives a tiny yield; plow-in restores much more soil budget. Not a food crop.</description>
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <Flammability>1.1</Flammability>
      <Nutrition>0.15</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Haygrass</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>10</pathCost>
    <ingestible />
    <plant>
      <immatureGraphicPath>Things/Plant/Haygrass_Immature</immatureGraphicPath>
      <fertilitySensitivity>0.5</fertilitySensitivity>
      <growDays>4.5</growDays>
      <dieIfLeafless>true</dieIfLeafless>
      <maxMeshCount>4</maxMeshCount>
      <harvestTag>Standard</harvestTag>
      <!-- Tiny seed yield if harvested normally; real value is plow-in. -->
      <harvestedThingDef>Hay</harvestedThingDef>
      <harvestYield>3</harvestYield>
      <sowMinSkill>3</sowMinSkill>
      <sowResearchPrerequisites>
        <li>FC_GreenManure</li>
      </sowResearchPrerequisites>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>0.35~0.7</visualSizeRange>
      <wildOrder>1</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

</Defs>

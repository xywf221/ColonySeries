  <FC_Designator_Topdress_Label>topdress soil</FC_Designator_Topdress_Label>
  <FC_Designator_Topdress_Desc>Order colonists to work compost into the soil, restoring soil budget. Requires field compost (or Landworks compost) and Soil budgeting research.</FC_Designator_Topdress_Desc>
  <FC_NeedSoilBudgeting>Requires research: soil budgeting</FC_NeedSoilBudgeting>
  <FC_CannotTopdressTerrain>Cannot topdress {0}</FC_CannotTopdressTerrain>
  <FC_NoCompost>No field compost available</FC_NoCompost>

  <FC_Designator_Fallow_Label>mark fallow</FC_Designator_Fallow_Label>
  <FC_Designator_Fallow_Desc>Toggle fallow on cells. Empty fallow cells slowly restore soil budget. Clear plants first for best effect. Click again to clear the mark. Requires crop rotation research.</FC_Designator_Fallow_Desc>
  <FC_NeedCropRotation>Requires research: crop rotation</FC_NeedCropRotation>
  <FC_CannotFallowTerrain>Cannot fallow {0}</FC_CannotFallowTerrain>

  <FC_Designator_Irrigate_Label>form / flood paddy</FC_Designator_Irrigate_Label>
  <FC_Designator_Irrigate_Desc>On soil: form a dry paddy bed. On dry paddy: flood it. Rice grows best on flooded paddies. Requires paddy works research.</FC_Designator_Irrigate_Desc>
  <FC_Designator_Drain_Label>drain paddy</FC_Designator_Drain_Label>
  <FC_Designator_Drain_Desc>Drain a flooded paddy back to dry paddy bed.</FC_Designator_Drain_Desc>
  <FC_NeedPaddyWorks>Requires research: paddy works</FC_NeedPaddyWorks>
  <FC_CannotIrrigateTerrain>Cannot form paddy on {0}</FC_CannotIrrigateTerrain>

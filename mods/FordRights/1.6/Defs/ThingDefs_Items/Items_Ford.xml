<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>FR_RiverFish</defName>
    <label>river fish</label>
    <description>A small catch from a colony ford. Slow to obtain, modest nutrition, spoils quickly — a riverside garnish, not a fishery empire.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/RiverFish</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>25</stackLimit>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <techLevel>Neolithic</techLevel>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>4.5</MarketValue>
      <Mass>0.35</Mass>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>4</DeteriorationRate>
      <Nutrition>0.22</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
      <Beauty>-1</Beauty>
    </statBases>
    <thingCategories>
      <li>FoodRaw</li>
    </thingCategories>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>RawBad</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
      <tasteThought>AteRawFood</tasteThought>
    </ingestible>
    <alwaysHaulable>true</alwaysHaulable>
    <socialPropernessMatters>true</socialPropernessMatters>
    <tradeability>Sellable</tradeability>
    <pathCost>14</pathCost>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Rottable">
        <daysToRotStart>3</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

</Defs>

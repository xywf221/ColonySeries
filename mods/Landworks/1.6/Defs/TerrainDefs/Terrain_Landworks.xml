<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TerrainDef Name="LW_TerrainSharedBase" Abstract="True">
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>336</renderPrecedence>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <filthAcceptanceMask>
      <li>Unnatural</li>
    </filthAcceptanceMask>
    <takeFootprints>true</takeFootprints>
    <categoryType>Soil</categoryType>
    <tags>
      <li>Soil</li>
      <li>Landworks</li>
    </tags>
    <tools>
      <li>
        <label>dirt</label>
        <capacities>
          <li>KickMaterialInEyes</li>
        </capacities>
        <hediff>DirtInEyes</hediff>
        <cooldownTime>1.5</cooldownTime>
      </li>
    </tools>
  </TerrainDef>

  <TerrainDef Name="LW_TerraformBase" ParentName="LW_TerrainSharedBase" Abstract="True">
    <designationCategory>Landworks</designationCategory>
    <constructEffect>ConstructDirt</constructEffect>
  </TerrainDef>

  <TerrainDef Name="LW_NaturalResultBase" ParentName="LW_TerrainSharedBase" Abstract="True">
  </TerrainDef>

  <!-- Reclaimed ordinary soil from fill -->
  <TerrainDef ParentName="LW_TerraformBase">
    <defName>LW_ReclaimedSoil</defName>
    <label>reclaimed soil</label>
    <description>Soil laid by hand over poor ground. Fertile enough to farm, but not as rich as natural topsoil. Costs soil fill to place. Counts toward geological stress.</description>
    <texturePath>Terrain/Surfaces/Soil</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/SoilPolluted</pollutedTexturePath>
    <pathCost>2</pathCost>
    <fertility>0.95</fertility>
    <statBases>
      <Beauty>-2</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
      <WorkToBuild>900</WorkToBuild>
    </statBases>
    <costList>
      <LW_SoilFill>4</LW_SoilFill>
    </costList>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <terrainAffordanceNeeded>Diggable</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>LW_BasicEarthworks</li>
    </researchPrerequisites>
  </TerrainDef>

  <!-- Artificial rich soil from compost - degrades via MapComponent -->
  <TerrainDef ParentName="LW_TerraformBase">
    <defName>LW_AmendedSoil</defName>
    <label>amended soil</label>
    <description>Soil heavily enriched with compost. Nearly as fertile as natural rich soil, but biologically unstable. Without a soil stabilizer or re-amendment it slowly degrades toward ordinary soil, then gravel. High geological stress.</description>
    <texturePath>Terrain/Surfaces/SoilRich</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/SoilRichPolluted</pollutedTexturePath>
    <pathCost>2</pathCost>
    <fertility>1.35</fertility>
    <renderPrecedence>334</renderPrecedence>
    <statBases>
      <Beauty>-1</Beauty>
      <BeautyOutdoors>1</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <costList>
      <LW_SoilFill>3</LW_SoilFill>
      <LW_Compost>3</LW_Compost>
    </costList>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <terrainAffordanceNeeded>GrowSoil</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>LW_Composting</li>
    </researchPrerequisites>
  </TerrainDef>

  <!-- Temporary tilled seedbed -->
  <TerrainDef ParentName="LW_TerraformBase">
    <defName>LW_TilledSoil</defName>
    <label>tilled seedbed</label>
    <description>Freshly tilled soil. Excellent fertility for a short time. Will settle after several days into reclaimed soil — or exhausted hardpan if the land was already stressed. Not free fertility forever.</description>
    <texturePath>Terrain/Surfaces/SoilRich</texturePath>
    <pathCost>4</pathCost>
    <fertility>1.7</fertility>
    <renderPrecedence>333</renderPrecedence>
    <layerable>true</layerable>
    <statBases>
      <Beauty>0</Beauty>
      <Cleanliness>-1</Cleanliness>
      <WorkToBuild>500</WorkToBuild>
    </statBases>
    <costList>
      <LW_Compost>1</LW_Compost>
    </costList>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <terrainAffordanceNeeded>GrowSoil</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>LW_FieldTillage</li>
    </researchPrerequisites>
  </TerrainDef>

  <!-- Exhausted hardpan - punishment state (not player-buildable) -->
  <TerrainDef ParentName="LW_NaturalResultBase">
    <defName>LW_ExhaustedSoil</defName>
    <label>exhausted hardpan</label>
    <description>Overworked, compacted ground. Almost infertile. Can be broken up with fill and compost, but it is a warning: the land has limits.</description>
    <texturePath>Terrain/Surfaces/PackedDirt</texturePath>
    <pathCost>3</pathCost>
    <fertility>0.15</fertility>
    <renderPrecedence>355</renderPrecedence>
    <statBases>
      <Beauty>-4</Beauty>
      <BeautyOutdoors>-1</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <tags>
      <li>Landworks</li>
      <li>Exhausted</li>
    </tags>
  </TerrainDef>

  <!-- Drained marsh bed -->
  <TerrainDef ParentName="LW_TerraformBase">
    <defName>LW_DrainedMarsh</defName>
    <label>drained marsh bed</label>
    <description>Former marsh after drainage works. Usable but damp and only moderately fertile. Expensive to create; raises flood risk nearby.</description>
    <texturePath>Terrain/Surfaces/MarshyTerrain</texturePath>
    <pathCost>6</pathCost>
    <fertility>0.85</fertility>
    <renderPrecedence>338</renderPrecedence>
    <statBases>
      <Beauty>-3</Beauty>
      <Cleanliness>-2</Cleanliness>
      <WorkToBuild>2200</WorkToBuild>
    </statBases>
    <costList>
      <LW_SoilFill>6</LW_SoilFill>
      <WoodLog>2</WoodLog>
    </costList>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <terrainAffordanceNeeded>Bridgeable</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>LW_Drainage</li>
    </researchPrerequisites>
  </TerrainDef>

  <!-- Reclaimed shallow water / embankment fill -->
  <TerrainDef ParentName="LW_TerraformBase">
    <defName>LW_EmbankmentFill</defName>
    <label>embankment fill</label>
    <description>Engineered fill that replaces shallow water or soft mud. Barely fertile; intended as a foundation for further soil work. Very expensive. Deep water cannot be reclaimed this way.</description>
    <texturePath>Terrain/Surfaces/Gravel</texturePath>
    <pathCost>2</pathCost>
    <fertility>0.4</fertility>
    <renderPrecedence>325</renderPrecedence>
    <statBases>
      <Beauty>-3</Beauty>
      <Cleanliness>-1</Cleanliness>
      <WorkToBuild>3500</WorkToBuild>
    </statBases>
    <costList>
      <LW_SoilFill>10</LW_SoilFill>
      <WoodLog>5</WoodLog>
    </costList>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <terrainAffordanceNeeded>Bridgeable</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>LW_Drainage</li>
    </researchPrerequisites>
  </TerrainDef>

  <!-- Advanced embankment for chest-deep -->
  <TerrainDef ParentName="LW_TerraformBase">
    <defName>LW_HeavyEmbankment</defName>
    <label>heavy embankment</label>
    <description>Industrial-grade fill for chest-deep water reclamation. Enormous material cost. Significantly raises geological stress. Ocean deeps remain impossible.</description>
    <texturePath>Terrain/Surfaces/PackedDirt</texturePath>
    <pathCost>1</pathCost>
    <fertility>0.25</fertility>
    <renderPrecedence>360</renderPrecedence>
    <statBases>
      <Beauty>-2</Beauty>
      <Cleanliness>-1</Cleanliness>
      <WorkToBuild>5000</WorkToBuild>
    </statBases>
    <costList>
      <LW_SoilFill>14</LW_SoilFill>
      <Steel>4</Steel>
      <WoodLog>6</WoodLog>
    </costList>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <terrainAffordanceNeeded>Bridgeable</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>LW_HydroTerraform</li>
    </researchPrerequisites>
  </TerrainDef>

  <!-- Excavation scar left after digging (not player-buildable) -->
  <TerrainDef ParentName="LW_NaturalResultBase">
    <defName>LW_ExcavationScar</defName>
    <label>excavation scar</label>
    <description>Ground left after soil was stripped for fill. Poor fertility and ugly. Can be refilled later — that is the point of conservation: dirt moved is dirt owed.</description>
    <texturePath>Terrain/Surfaces/Gravel</texturePath>
    <pathCost>3</pathCost>
    <fertility>0.35</fertility>
    <renderPrecedence>318</renderPrecedence>
    <statBases>
      <Beauty>-5</Beauty>
      <BeautyOutdoors>-2</BeautyOutdoors>
      <Cleanliness>-2</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
      <li>Walkable</li>
    </affordances>
    <tags>
      <li>Landworks</li>
      <li>Scar</li>
    </tags>
  </TerrainDef>

</Defs>

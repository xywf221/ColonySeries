<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>LW_SoilStabilizer</defName>
    <label>soil stabilizer</label>
    <description>An industrial soil-management unit. While powered, it maintains artificial soils in a wide radius so they do not degrade, and slowly bleeds off geological stress caused by terraforming. Does nothing while unpowered. Essential for large engineered farms.</description>
    <graphicData>
      <texPath>Things/Building/SoilStabilizer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
      <shadowData>
        <volume>(0.7, 0.4, 0.7)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-6</Beauty>
      <Mass>45</Mass>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <LW_Compost>20</LW_Compost>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>220</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="Landworks.CompProperties_SoilStabilizer">
        <radius>9.9</radius>
        <stressReliefPerDay>4</stressReliefPerDay>
      </li>
    </comps>
    <specialDisplayRadius>9.9</specialDisplayRadius>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <designationCategory>Landworks</designationCategory>
    <uiOrder>2500</uiOrder>
    <researchPrerequisites>
      <li>LW_SoilEngineering</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
  </ThingDef>

</Defs>

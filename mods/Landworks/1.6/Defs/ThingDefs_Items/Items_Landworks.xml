<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>LW_SoilFill</defName>
    <label>soil fill</label>
    <description>Excavated earth used to fill poor ground, build embankments, or reclaim shallow water. Heavy, dirty, and worthless for trade — but essential for terraforming. Quality is conserved: every bag of fill came from somewhere else on the map.</description>
    <graphicData>
      <texPath>Things/Item/SoilFill</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <techLevel>Neolithic</techLevel>
    <statBases>
      <MarketValue>0.4</MarketValue>
      <Mass>0.8</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <MaxHitPoints>80</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>LW_Compost</defName>
    <label>compost</label>
    <description>Aged organic matter used to enrich soil. Worked into ordinary ground it creates artificial rich soil — highly fertile, but biologically unstable. Without a soil stabilizer or periodic re-composting it will degrade over time.</description>
    <graphicData>
      <texPath>Things/Item/Compost</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <techLevel>Neolithic</techLevel>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Mass>0.45</Mass>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>3</DeteriorationRate>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToMake>400</WorkToMake>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <RecipeDef>
    <defName>LW_MakeCompostFromHay</defName>
    <label>make compost from hay</label>
    <description>Compost hay into soil amendment. Efficient and clean.</description>
    <jobString>Making compost.</jobString>
    <workAmount>450</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <allowMixingIngredients>false</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <LW_Compost>5</LW_Compost>
    </products>
    <workSkill>Plants</workSkill>
    <skillRequirements>
      <Plants>3</Plants>
    </skillRequirements>
    <researchPrerequisite>LW_Composting</researchPrerequisite>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>LW_MakeCompostFromWood</defName>
    <label>make compost from wood pulp</label>
    <description>Slowly break wood into coarse compost. Less efficient than hay, but useful when plant feed is scarce.</description>
    <jobString>Making compost from wood.</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>ConstructDirt</effectWorking>
    <allowMixingIngredients>false</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <LW_Compost>4</LW_Compost>
    </products>
    <workSkill>Plants</workSkill>
    <skillRequirements>
      <Plants>4</Plants>
    </skillRequirements>
    <researchPrerequisite>LW_Composting</researchPrerequisite>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

</Defs>

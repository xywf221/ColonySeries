<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef>
    <defName>QL_Quarantined</defName>
    <thoughtClass>QuarantineLine.Thought_Quarantined</thoughtClass>
    <workerClass>QuarantineLine.ThoughtWorker_Quarantined</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>quarantined</label>
        <description>I'm stuck in the isolation ward. Necessary, maybe — still lonely.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>strict isolation</label>
        <description>Doors sealed, visitors barred. The colony is protecting itself from me.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>QL_VisitingWard</defName>
    <thoughtClass>QuarantineLine.Thought_VisitingWard</thoughtClass>
    <workerClass>QuarantineLine.ThoughtWorker_VisitingWard</workerClass>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>visiting the sick ward</label>
        <description>I'm in the quarantine zone with the sick. Feels risky.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>QL_IsolationRounds</defName>
    <thoughtClass>QuarantineLine.Thought_IsolationRounds</thoughtClass>
    <workerClass>QuarantineLine.ThoughtWorker_IsolationRounds</workerClass>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>isolation protocol rounds</label>
        <description>Strict isolation means more carefully timed care, PPE fuss, and extra trips. Doctoring is harder.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>

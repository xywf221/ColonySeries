<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>SA_FieldPatch_Armor</defName>
    <label>field plating patch</label>
    <description>Jury-rigged mechanoid plating scraps on worn gear. Temporary personal armor only; wears off. Not a permanent global buff.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.7, 0.85)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.25</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000~45000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>light scrap</label>
        <statOffsets>
          <ArmorRating_Sharp>0.04</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.02</ArmorRating_Blunt>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>layered scrap</label>
        <statOffsets>
          <ArmorRating_Sharp>0.07</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
          <ArmorRating_Heat>0.03</ArmorRating_Heat>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>field carapace</label>
        <statOffsets>
          <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.06</ArmorRating_Blunt>
          <ArmorRating_Heat>0.05</ArmorRating_Heat>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.02</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>SA_FieldPatch_Optics</defName>
    <label>jury-rigged optics</label>
    <description>Salvaged sensor glass on a visor. Slight aiming aid while it lasts - personal and temporary.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.8, 0.7)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.25</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>25000~40000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>smudged glass</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.5</ShootingAccuracyPawn>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>tuned lenses</label>
        <statOffsets>
          <ShootingAccuracyPawn>1.0</ShootingAccuracyPawn>
          <AimingDelayFactor>-0.04</AimingDelayFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>sensor suite</label>
        <statOffsets>
          <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
          <AimingDelayFactor>-0.07</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>SA_FieldPatch_Coolant</defName>
    <label>coolant drip rig</label>
    <description>Portable mech coolant loop. Helps heat tolerance briefly; can slow you slightly at full power.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.75, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.25</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>28000~42000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>drip feed</label>
        <statOffsets>
          <ComfyTemperatureMax>4</ComfyTemperatureMax>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>circulating</label>
        <statOffsets>
          <ComfyTemperatureMax>8</ComfyTemperatureMax>
          <ComfyTemperatureMin>-2</ComfyTemperatureMin>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>overclocked loop</label>
        <statOffsets>
          <ComfyTemperatureMax>12</ComfyTemperatureMax>
          <ComfyTemperatureMin>-3</ComfyTemperatureMin>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.03</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>

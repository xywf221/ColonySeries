<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>SA_MechFragment</defName>
    <label>mech fragment</label>
    <description>A scorched shard of mechanoid circuitry. Not a research unlock by itself - analyze at a salvage bench to bank atlas progress, then spend that progress on bounded reverse-engineering ranks.</description>
    <graphicData>
      <texPath>Things/Item/MechFragment</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.75</drawSize>
    </graphicData>
    <stackLimit>50</stackLimit>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MarketValue>8</MarketValue>
      <Mass>0.15</Mass>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>1.5</DeteriorationRate>
      <MaxHitPoints>40</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeability>Sellable</tradeability>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>SA_AtlasSchematic</defName>
    <label>atlas schematic</label>
    <description>A one-shot reverse-engineering printout from the salvage atlas. Decode once for a small materials package - never a permanent global combat buff.</description>
    <graphicData>
      <texPath>Things/Item/AtlasSchematic</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MarketValue>120</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1.0</Flammability>
      <MaxHitPoints>20</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="SalvageAtlas.CompProperties_AtlasSchematic" />
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
</Defs>

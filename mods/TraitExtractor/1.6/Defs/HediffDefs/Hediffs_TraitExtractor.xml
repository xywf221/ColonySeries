<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="DiseaseBase">
    <defName>TE_NeuralTrauma</defName>
    <label>neural extraction trauma</label>
    <labelNoun>neural extraction trauma</labelNoun>
    <description>Acute trauma from invasive personality-pattern extraction. Consciousness and manipulation are impaired while the brain rewires.</description>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>0.8</initialSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.12</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>recovering</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.12</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DiseaseBase">
    <defName>TE_NeuroAdaptation</defName>
    <label>neuro-adaptation</label>
    <labelNoun>neuro-adaptation sickness</labelNoun>
    <description>The brain is integrating an injected personality pattern. Causes nausea, fog and temporary skill noise.</description>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>0.7</initialSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.22</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>adapting</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>TE_NeuralScar</defName>
    <label>neural extraction scar</label>
    <labelNoun>a neural extraction scar</labelNoun>
    <description>Permanent scarring of personality-linked neural tissue from aggressive extraction. Slight lasting consciousness penalty.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <isBad>true</isBad>
    <chronic>true</chronic>
    <priceImpact>true</priceImpact>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DiseaseBase">
    <defName>TE_ExtractionCooldown</defName>
    <label>neural recovery lockout</label>
    <description>Recently extracted or injected. Further trait operations are unsafe until this clears.</description>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.07</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>locked out</label>
      </li>
    </stages>
  </HediffDef>

</Defs>

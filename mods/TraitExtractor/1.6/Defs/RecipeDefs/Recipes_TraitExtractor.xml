<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>TE_ExtractTrait</defName>
    <label>extract personality trait</label>
    <description>Invasively map and extract one personality trait into a trait serum. Always causes neural trauma. May leave permanent scarring. Scenario-forced and gene-bound traits cannot be taken. Prisoner extractions are severe violations.</description>
    <workerClass>TraitExtractor.Recipe_ExtractTrait</workerClass>
    <jobString>Extracting personality trait.</jobString>
    <workAmount>4500</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>true</anesthetize>
    <isViolation>true</isViolation>
    <surgerySuccessChanceFactor>0.65</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0.08</deathOnFailedSurgeryChance>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <skillRequirements>
      <Medicine>10</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineUltratech</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>TE_ExtractionKit</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineUltratech</li>
        <li>TE_ExtractionKit</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <researchPrerequisite>TE_TraitExtraction</researchPrerequisite>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
  </RecipeDef>

</Defs>

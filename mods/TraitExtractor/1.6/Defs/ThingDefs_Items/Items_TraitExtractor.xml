<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>TE_ExtractionKit</defName>
    <label>neural extraction kit</label>
    <description>Single-use surgical kit for mapping and lifting a personality trait into a serum vial. Requires a trained doctor and glitterworld-grade medicine during the operation. Destroyed on use.</description>
    <graphicData>
      <texPath>Things/Item/ExtractionKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <stackLimit>5</stackLimit>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MarketValue>420</MarketValue>
      <Mass>1.2</Mass>
      <Flammability>0.4</Flammability>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToMake>4500</WorkToMake>
      <DeteriorationRate>1.5</DeteriorationRate>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Neutroamine>15</Neutroamine>
      <MedicineIndustrial>2</MedicineIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <researchPrerequisite>TE_TraitExtraction</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
        <Intellectual>5</Intellectual>
      </skillRequirements>
      <displayPriority>950</displayPriority>
    </recipeMaker>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>TE_ExtractionGear</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>TE_TraitSerum</defName>
    <label>trait serum</label>
    <description>A cryo-stabilized neural pattern serum carrying one personality trait. Inject to attempt integration. Rejection, conflict with existing traits, and multi-day adaptation sickness are common. Not a toy. Settlement and exotic traders sometimes stock pre-filled vials.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/TraitSerum</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <techLevel>Ultra</techLevel>
    <!-- All = buy and sell. Do NOT put on ExoticMisc: vanilla tag stock would spawn empty vials. -->
    <tradeability>All</tradeability>
    <tradeTags>
      <li>TE_TraitSerum</li>
    </tradeTags>
    <statBases>
      <MarketValue>1100</MarketValue>
      <Mass>0.25</Mass>
      <Flammability>0.2</Flammability>
      <MaxHitPoints>40</MaxHitPoints>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <comps>
      <li Class="TraitExtractor.CompProperties_TraitSerum" />
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Inject {0_label}</useLabel>
        <useDuration>900</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>TraitExtractor.CompUseEffect_InjectTrait</compClass>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

  <!-- Medical bill version: doctor injects serum into a bedridden patient -->
  <RecipeDef>
    <defName>TE_AdministerTraitSerum</defName>
    <label>administer trait serum</label>
    <description>Inject a trait serum into a patient under medical supervision.</description>
    <workerClass>TraitExtractor.Recipe_AdministerTraitSerum</workerClass>
    <jobString>Administering trait serum.</jobString>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <workAmount>900</workAmount>
    <dontShowIfAnyIngredientMissing>true</dontShowIfAnyIngredientMissing>
    <surgeryOutcomeEffect IsNull="True" />
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>TE_TraitSerum</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>TE_TraitSerum</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
  </RecipeDef>

</Defs>

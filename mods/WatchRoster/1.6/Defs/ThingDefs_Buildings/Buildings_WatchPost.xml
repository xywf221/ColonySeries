<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>WR_WatchPost</defName>
    <label>watch post</label>
    <description>A simple raised post with a lantern and rail. At night, a colonist can stand watch here. Manned posts grant early raid warning and faster fire notice. Empty posts only weaken night fire awareness — they never unlock doors or raise raid points. Build at most a handful; this is a post, not a duty roster UI.</description>
    <thingClass>WatchRoster.Building_WatchPost</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/WatchPost</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2, 1.2)</drawSize>
      <damageData>
        <rect>(0.2,0.25,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(0.65, 0.2, 0.5)</volume>
        <offset>(0, 0, -0.05)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>UI/Designators/WatchPost</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <fillPercent>0.25</fillPercent>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>1</Beauty>
      <Mass>25</Mass>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
      <Steel>15</Steel>
    </costList>
    <building>
      <isEdifice>true</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Wood_Small</destroySound>
      <expandHomeArea>false</expandHomeArea>
      <watchBuildingStandDistanceRange>0~0</watchBuildingStandDistanceRange>
      <watchBuildingStandRectWidth>1</watchBuildingStandRectWidth>
    </building>
    <size>(1,1)</size>
    <designationCategory>Security</designationCategory>
    <uiOrder>45</uiOrder>
    <constructionSkillPrerequisite>0</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>WatchRoster.PlaceWorker_WatchPostLimit</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Glower">
        <glowRadius>3.5</glowRadius>
        <glowColor>(255,200,90,0)</glowColor>
      </li>
    </comps>
    <tickerType>Never</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
  </ThingDef>

</Defs>
